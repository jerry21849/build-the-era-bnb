# WalletConnect Cloud project id (for RainbowKit wallet modal).
# Get one at https://cloud.walletconnect.com — free tier is fine.
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional: override the public BSC RPC. Default uses publicnode.com.
NEXT_PUBLIC_BSC_RPC=https://bsc-rpc.publicnode.com

# TermiX backend base. Default is production.
NEXT_PUBLIC_TERMIX_BASE=https://platform-backend.prod.termix.live

# Server-side only — used by API rewrites. Must be set in Vercel project env,
# never exposed to the browser bundle.
# TERMIX_PLATFORM_API_KEY=